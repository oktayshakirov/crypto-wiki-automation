      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "done-offsets",
              "leftValue": "={{ String($json.start_offset) }}",
              "rightValue": "={{ String($json.end_offset) }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "67d61738-7ee1-4b03-8b17-9af8398792a9"
    },
    {
      "name": "Next Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        500
      ],
      "parameters": {
        "jsCode": "// Facebook names the next byte range in every start/transfer response, as\n// strings. The session id lives on FB Start's single run; runIndex 0 is pinned\n// so the reference cannot drift to a loop iteration.\nconst r = $input.first().json;\nconst start = Number(r.start_offset);\nconst end = Number(r.end_offset);\nif (!(end > start)) throw new Error(`Bad range from Facebook: ${JSON.stringify(r)}`);\nreturn [{ json: {\n  session: $('FB Start').first(0, 0).json.upload_session_id,\n  start,\n  end,\n  range: `bytes=${start}-${end - 1}`,\n  url: $('Normalise Input').first(0, 0).json.videoFetchUrl,\n} }];"
      },
      "id": "bdd80fb3-9042-4f23-8207-c84f59231c95"
    },
    {
