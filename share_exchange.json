    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const name = $('Parse Frontmatter').item.json.name || \"Exchange\";\n  const link = $('Parse Frontmatter').item.json.link || \"http://thecrypto.wiki/exchanges\";\n  const slug = $('Set Slug').item.json.slug || \"exchange\";\n\n  const variants = [\n    `Check out our latest ${name} review \ud83d\udd0e Features, pros & cons for crypto traders. \ud83d\udc47 {{link}}`,\n    `Curious about ${name}? Our review covers fees, security & usability \u2014 all you need before trading digital assets. \ud83d\udc47 {{link}}`,\n    `We reviewed ${name} so you don't have to. Key insights on this crypto exchange \ud83d\udc47 {{link}}`,\n    `Thinking about trading on ${name}? Our review explores its strengths & weaknesses to help you decide. \ud83d\udc47 {{link}}`,\n    `${name} under review \ud83d\udd0d From security to fees, here's what every trader should know before using this exchange. \ud83d\udc47 {{link}}`,\n    `Is ${name} the right platform for your crypto journey? \ud83d\ude80 Our latest review breaks down the essentials. \ud83d\udc47 {{link}}`\n  ];\n\n  const variant = variants[Math.floor(Math.random() * variants.length)];\n  const fbTwPost = variant.replace(\"{{link}}\", link);\n  const igPost = variant.replace(\"{{link}}\", \"Read more at thecrypto.wiki\");\n  const instagramImageUrl = `https://raw.githubusercontent.com/oktayshakirov/crypto-wiki-automation/refs/heads/main/images/exchanges/${slug}.png?v=${Date.now()}`;\n    const binary = $('Download APITemplate Image').item.binary || {};\n\n  return {\n    json: {\n      ...item.json,\n      facebook: fbTwPost,\n      twitter: fbTwPost,\n      instagramCaption: igPost,\n      imageUrl: instagramImageUrl,\n      link: link\n    },\n    binary\n  };\n});"
      },
