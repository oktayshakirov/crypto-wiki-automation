      "parameters": {
        "formTitle": "Crypto Wiki: Publish Reel",
        "formDescription": "Publishes one vertical video as an Instagram Reel and a Facebook Reel. Both URLs must be publicly reachable for the length of the run.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "videoUrl",
              "requiredField": true
            },
            {
              "fieldLabel": "coverUrl",
              "requiredField": true
            },
            {
              "fieldLabel": "caption",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "durationSeconds",
              "requiredField": true
            },
            {
              "fieldLabel": "facebookCaption",
              "fieldType": "textarea",
              "requiredField": false
            }
          ]
        },
        "options": {},
        "path": "6d62a5fb-66ee-415e-b6fd-c125fbe6c3a5"
      },
      "name": "Form Trigger",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        -460,
        300
      ],
      "id": "8d1d41ff-eccf-4743-a25e-00cf920a803e",
      "webhookId": "6d62a5fb-66ee-415e-b6fd-c125fbe6c3a5"
    },
    {
      "parameters": {
        "jsCode": "// The form gives us field labels when triggered from the browser and `field-N`\n// when triggered over HTTP. Read both: a run triggered by index that silently\n// produced nulls is exactly how a previous workflow published an article about\n// the wrong subject.\nconst j = $json;\nconst pick = (label, idx) => String(j[label] ?? j[`field-${idx}`] ?? '').trim();\n\nconst videoUrl = pick('videoUrl', 0);\nconst coverUrl = pick('coverUrl', 1);\nconst caption  = pick('caption', 2);\nconst duration = Number(pick('durationSeconds', 3) || '0');\n// Facebook Reel caption is separate so a clickable article link can ride the\n// Facebook post without showing as dead text on Instagram, where caption links\n// are not tappable. Optional: blank means reuse the Instagram caption as-is.\nconst facebookCaption = pick('facebookCaption', 4) || caption;\n\nfor (const [name, value] of [['videoUrl', videoUrl], ['coverUrl', coverUrl]]) {\n  if (!/^https:\\/\\//.test(value)) {\n    throw new Error(`${name} must be a public https URL, got: ${value || '(empty)'}`);\n  }\n}\nif (!caption) throw new Error('caption is empty. A Reel published with no caption cannot be edited into one later.');\n\n// Facebook Reels are 3 to 90 seconds. Instagram allows far longer, but this\n// workflow posts the same file to both, so the tighter limit is the real one.\n// Checked here rather than discovered after the bytes have been uploaded.\nif (!Number.isFinite(duration) || duration <= 0) {\n  throw new Error('durationSeconds is required so the 90 second Facebook Reels limit can be checked before uploading.');\n}\nif (duration < 3 || duration > 90) {\n  throw new Error(`This video is ${duration}s. Facebook Reels accepts 3 to 90 seconds, so it cannot be published as a Reel.`);\n}\n\nreturn [{ json: { videoUrl, coverUrl, caption, facebookCaption, duration } }];"
      },
